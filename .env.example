# Copy to .env and fill in real values. Do not commit real secrets.

# Postgres connection used by Prisma at runtime (pooled connection in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) Postgres connection used for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secrets for signing JWT access / refresh tokens (use long random strings)
JWT_SECRET="replace-with-random-secret"
JWT_REFRESH_SECRET="replace-with-random-secret"

# For .env.test only: both URLs MUST include schema=test (enforced by vitest.config.ts)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_test?schema=test"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_test?schema=test"
